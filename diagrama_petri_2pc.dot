digraph G {
  rankdir=LR; nodesep=0.45; ranksep=0.75; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11];
  edge [fontsize=9];

  node [shape=circle, style=filled, fillcolor="#FFFFFF", width=0.55];
  CI [label="C_Inicio\n●", fillcolor="#DDEBF7"];
  CE [label="C_Esperando", fillcolor="#DDEBF7"];
  CC [label="C_Commit", fillcolor="#DDEBF7"];
  PI [label="P_Init\n●", fillcolor="#E2EFDA"];
  PP [label="P_Prepared", fillcolor="#E2EFDA"];
  EC [label="Estado_Commit", fillcolor="#E2EFDA"];
  node [fillcolor="#FFF2CC", width=0.4];
  MP [label="Msg_Prepare"]; MY [label="Msg_VoteYes"]; MC [label="Msg_Commit"];

  node [shape=box, style=filled, fillcolor="#404040", fontcolor="white", height=0.35];
  t1 [label="EnviarPrepare"];
  t2 [label="VotaYes"];
  t4 [label="DecideCommit"];
  t6 [label="AplicaCommit"];

  CI->t1; t1->CE; t1->MP;
  PI->t2; MP->t2; t2->PP; t2->MY;
  CE->t4; MY->t4; t4->CC; t4->MC;
  PP->t6; MC->t6; t6->EC;
}
